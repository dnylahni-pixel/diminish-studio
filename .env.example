# Local development only.
# Copy this file to `.env.local`; never put real values in this tracked file.

# Local processes
API_PORT=3000
WEB_PORT=5173
BASE_PATH=/
NODE_ENV=development
LOG_LEVEL=debug
RUN_MIGRATIONS=false

# Frontend-safe values (these are embedded in the browser bundle)
VITE_API_BASE_URL=http://localhost:3000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Backend secrets
# Use a separate Neon development branch/database, not production.
DATABASE_ENVIRONMENT=development
DATABASE_URL=postgresql://replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Backblaze B2
# Prefer a separate development bucket and an application key scoped to it.
B2_ENDPOINT=https://s3.replace_me.backblazeb2.com
B2_REGION=replace_me
B2_KEY_ID=replace_me
B2_APPLICATION_KEY=replace_me
BUCKET_NAME=replace_me_dev

# RunPod is optional for normal UI/API development.
# Leave both empty until testing analysis intentionally; real calls may cost money.
RUNPOD_ENDPOINT=
RUNPOD_API_KEY=
